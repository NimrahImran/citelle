# Copy to .env for local development. On Vercel, add these in Project Settings → Environment Variables.

# Google Gemini API key (https://aistudio.google.com/apikey). Enables semantic search and written answers.
GEMINI_API_KEY=

# Optional: pin models instead of automatic selection.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001

# Contact form: a Gmail address and a Gmail App Password (Google Account → Security → App passwords).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional: deliver messages to a different inbox (defaults to GMAIL_USER).
# CONTACT_TO=

# Optional: absolute site address for link previews (defaults to the Vercel production domain).
# VITE_SITE_URL=https://citelle-azure.vercel.app
