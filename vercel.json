{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/embed-book.mjs && vite build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "citelle-azure.vercel.app"
        }
      ],
      "destination": "https://citelle-ai.vercel.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|assets/|data/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/answer.js": {
      "maxDuration": 60
    },
    "api/embed.js": {
      "maxDuration": 30
    },
    "api/ocr.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
